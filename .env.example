# Google AI Studio — free tier, no card required: https://aistudio.google.com
GEMINI_API_KEY=
# Optional. A second key (from a different Google account/project) that
# generateWithFailover() switches to automatically when the first key hits
# its daily quota (HTTP 429) — the free tier's quota is per-key, not shared.
GEMINI_API_KEY_2=

# Supabase — Project Settings > API. Both are safe to expose to the browser:
# the anon key only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
