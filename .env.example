# Google AI Studio — free tier, no card required: https://aistudio.google.com
GEMINI_API_KEY=
# Optional. A second key (from a different Google account/project) that
# generateWithFailover() switches to automatically when the first key hits
# its daily quota (HTTP 429) — the free tier's quota is per-key, not shared.
GEMINI_API_KEY_2=

# Supabase — Project Settings > API. Both are safe to expose to the browser:
# the anon key only grants what Row Level Security allows.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — Project Settings > API > "service_role" secret.
# UNLIKE the anon key above, this bypasses Row Level Security entirely and
# must NEVER be exposed to the browser (no NEXT_PUBLIC_ prefix, never logged,
# never sent to the client). Used only by app/api/courses/search to write to
# course_video_cache, a table shared across all users with no per-user RLS
# policy a normal signed-in client could satisfy.
SUPABASE_SERVICE_ROLE_KEY=

# YouTube Data API v3 — free tier, no card required, ~10,000 units/day
# (a single search costs 100 units, so about 100 searches/day for the app).
# console.cloud.google.com > same project as Gemini > APIs & Services >
# Library > enable "YouTube Data API v3" > Credentials > Create API key.
YOUTUBE_API_KEY=
